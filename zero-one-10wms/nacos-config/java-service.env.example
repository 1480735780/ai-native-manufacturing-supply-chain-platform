# Java 服务生产环境变量模板（仅占位符，禁止直接用于启动）
# 用法：复制到受控 Secret/EnvironmentFile，替换全部 <...> 后执行：
#   python3 nacos-config/validate-java-env.py --env-file /secure/path/java-service.env
# 本文件不得写入真实口令，也不得提交填值后的副本。

# MySQL：nacos-config/data-source.yaml
WMS_DB_HOST=<prod-db-host>
WMS_DB_PORT=<prod-db-port>
WMS_DB_USERNAME=<prod-db-least-privilege-user>
WMS_DB_PASSWORD=<prod-db-new-strong-password>

# Redis：nacos-config/data-source.yaml
WMS_REDIS_HOST=<prod-redis-host>
WMS_REDIS_PORT=<prod-redis-port>
WMS_REDIS_PASSWORD=<prod-redis-new-strong-password>

# MongoDB：nacos-config/data-source.yaml
WMS_MONGO_HOST=<prod-mongo-host>
WMS_MONGO_PORT=<prod-mongo-port>
WMS_MONGO_USERNAME=<prod-mongo-least-privilege-user>
WMS_MONGO_PASSWORD=<prod-mongo-new-strong-password>

# oauth2 starter 管理端客户端：nacos-config/key-config.yaml
WMS_OAUTH2_MGR_ID=<prod-oauth2-manager-client-id>
WMS_OAUTH2_MGR_PASSWORD=<prod-oauth2-manager-new-strong-secret>

# 异常巡检服务账号与 API Key：wms-login / wms-oauth2
AGENT_SERVICE_API_KEY=<prod-agent-new-strong-api-key>
AGENT_SERVICE_API_KEY_ID=<prod-agent-new-key-id>
AGENT_SERVICE_USERNAME=<prod-agent-read-only-service-user>
AGENT_SERVICE_PASSWORD=<prod-agent-service-new-strong-password>
AGENT_SERVICE_WAREHOUSES=<prod-agent-allowed-warehouse-codes>
AGENT_SERVICE_TOKEN_TTL_SECONDS=<prod-agent-token-ttl-seconds>
# 协议值非凭据，但模板仍留占位；替换后必须严格等于 agent_service。
AGENT_SERVICE_TOKEN_USE=<agent_service>
AGENT_SERVICE_TOKEN_ISSUER=<prod-agent-token-issuer>
AGENT_SERVICE_IP_WHITELIST=<prod-agent-egress-ip-list>

# 服务令牌签名：JKS 与 PKCS#8 PEM 二选一；默认校验要求至少配置一种。
# JKS 方式（wms-login 与 wms-oauth2 必须使用同一把 prod 新密钥）：
AGENT_SERVICE_JKS_PATH=<prod-jks-absolute-path>
AGENT_SERVICE_JKS_PASSWORD=<prod-jks-new-strong-store-password>
AGENT_SERVICE_KEY_ALIAS=<prod-jks-key-alias>
AGENT_SERVICE_KEY_PASSWORD=<prod-jks-new-strong-key-password>
# PEM 方式：启用时取消下一行注释，并删除/留空上述 JKS 变量。
# AGENT_SERVICE_PRIVATE_KEY_PATH=<prod-pkcs8-private-key-absolute-path>

# 可选 API Key 双 key 宽限期：两个变量必须同时设置或同时留空。
# AGENT_SERVICE_API_KEY_PREVIOUS=<prod-agent-previous-strong-api-key>
# AGENT_SERVICE_API_KEY_PREVIOUS_ID=<prod-agent-previous-key-id>

# FastDFS：nacos-config/third-services.yaml
FASTDFS_HTTP_SECRET_KEY=<prod-fastdfs-new-strong-http-secret>
