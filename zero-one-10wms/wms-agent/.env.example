# WMS Agent 环境变量样例（ADR-014：非密可入库，密钥只进本地 .env）
# 复制为 .env 后填写；.env 已被仓库根 .gitignore 排除，禁止提交。

# 服务
WMS_AGENT_HOST=127.0.0.1
WMS_AGENT_PORT=11200

# Gateway
WMS_GATEWAY_URL=http://127.0.0.1:10001
# 单次工具调用的超时（秒）
WMS_AGENT_TOOL_TIMEOUT_SECONDS=3

# JWT 验签公钥（RS256）
WMS_JWT_PUBLIC_KEY_PATH=../wms-java/wms-common/src/main/resources/public.pem

# LLM（密钥只放本地 .env / 运行环境，禁止入库）
WMS_AGENT_LLM_PROVIDER=mock
WMS_AGENT_LLM_BASE_URL=https://api.agnes-ai.cn/v1
WMS_AGENT_LLM_MODEL=agnes-3.0-flash
WMS_AGENT_LLM_API_KEY=
WMS_AGENT_LLM_TIMEOUT_SECONDS=8
# mock provider 的回放场景（本地 JSON 路径，仅离线回放用；留空则 mock 无场景）
WMS_AGENT_LLM_SCENARIO_PATH=

# Nacos（可选，只读拉配置）
WMS_AGENT_NACOS_ENABLED=false

# trace 存储（F-012 起启用；PG 可在本机或虚拟机 docker，schema 固定 wms_agent）
# 默认走 PG 持久化；无 PG 环境可改回 memory 降级（响应 persisted=false，问数不失败）。
WMS_AGENT_STORE_BACKEND=postgres
# 按实际 PG 实例填写；此处为本地/容器示例，口令请替换为部署环境的值。
# 例（虚拟机 docker）：postgresql://postgres:postgres@192.168.89.128:5432/ragent
WMS_AGENT_DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/ragent

# 异常巡检非密配置（版本化 YAML，启动加载一次；密钥不要写入该文件）
WMS_AGENT_SCAN_CONFIG_PATH=config/scan.yaml
# 以下三项仅在显式设置时覆盖 scan.yaml，并写入每次扫描的生效配置快照。
# 仓库首版强制单仓：Java 数据源不支持按仓库过滤，多仓拒绝启动。
WMS_AGENT_SCAN_WAREHOUSES=W01
# 通知模式：dry_run 只落通知记录不发送；in_app 写自有通知；full 暂不启用
WMS_AGENT_NOTIFICATION_MODE=dry_run
# 定时 in_app 通知接收人（逗号分隔用户名）；手动扫描默认推给发起人。
WMS_AGENT_ALERT_RECIPIENTS=
# 持久队列与 worker：POST 只入队返回 202，由后台 worker 消费已落库记录。
# worker 始终随服务启动；是否定时巡检只由 config/scan.yaml 的 schedule.enabled 决定（默认关闭）。
WMS_AGENT_SCAN_WORKER_POLL_SECONDS=2
# 租约时长（秒）：worker 领取写 lease_owner/leased_at，执行期间按 1/3 周期心跳续租；
# 超过该时长无心跳的 running 由周期恢复重新入队（attempt<3）或标 failed(stale)
WMS_AGENT_SCAN_LEASE_SECONDS=60
# 定时巡检取短时令牌（不把用户 JWT 持久化到队列；密钥只进本地 .env）
WMS_AGENT_SERVICE_TOKEN_URL=http://127.0.0.1:10001/login/service-token
WMS_AGENT_SERVICE_API_KEY=
WMS_AGENT_SERVICE_KEY_ID=
WMS_AGENT_SERVICE_WAREHOUSE=
# worker 解码服务令牌后强制校验的账号名（对齐 Java agent.service.username）
WMS_AGENT_SERVICE_ACCOUNT_NAME=agent-inspector
# 保留与归档（ADR-020）：已结案告警 / 事件 / 扫描摘要 / 扫描记录及其证据、通知 在线 N 天后转归档表，
# 归档再保留 M 天；问数 trace/tool_calls 与超过 2 年的指标日聚合到期直接删除。
# 自动任务默认关闭，每天先补齐指标日聚合再归档；
# 管理员可随时调 POST /agent/scan/metrics/rollup/run 与 POST /agent/scan/retention/run 手动执行（每轮受批数 × 批大小限制）。
WMS_AGENT_RETENTION_ENABLED=false
WMS_AGENT_RETENTION_ALERTS_ONLINE_DAYS=180
WMS_AGENT_RETENTION_ARCHIVE_DAYS=365
WMS_AGENT_RETENTION_NOTIFICATIONS_DAYS=90
WMS_AGENT_RETENTION_TRACE_DAYS=90
WMS_AGENT_RETENTION_METRICS_DAYS=730
WMS_AGENT_RETENTION_BATCH_SIZE=500
WMS_AGENT_RETENTION_MAX_BATCHES=20
# 自动任务的每日执行时刻（HH:MM）与时区；过了该时刻当天只跑一次
WMS_AGENT_RETENTION_DAILY_AT=02:30
WMS_AGENT_RETENTION_TIMEZONE=Asia/Shanghai
