<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
    <fo:layout-master-set>
        <fo:simple-page-master master-name="A4" page-height="29.7cm" page-width="21cm"
                               margin-top="1cm" margin-bottom="1cm" margin-left="1cm" margin-right="1cm">
            <fo:region-body margin-top="1cm" margin-bottom="1cm"/>
        </fo:simple-page-master>
    </fo:layout-master-set>

    <fo:page-sequence font-family="微软雅黑" master-reference="A4">
        <fo:flow flow-name="xsl-region-body">
            <fo:block font-size="16pt" font-weight="bold" text-align="center" space-after="5mm">
                货品信息
            </fo:block>

            <fo:block font-size="10pt" space-after="3mm">
                通知单号：<fo:inline font-weight="bold">${noticeId!}</fo:inline>
                　客户：<fo:inline font-weight="bold">${cusCode!}</fo:inline>
                　供应商：<fo:inline font-weight="bold">${supName!}</fo:inline>
            </fo:block>

            <fo:table table-layout="fixed" width="100%" border-collapse="collapse">
                <fo:table-column column-width="10%"/>
                <fo:table-column column-width="16%"/>
                <fo:table-column column-width="26%"/>
                <fo:table-column column-width="10%"/>
                <fo:table-column column-width="8%"/>
                <fo:table-column column-width="15%"/>
                <fo:table-column column-width="15%"/>
                <fo:table-body>
                    <fo:table-row background-color="#EEEEEE">
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block font-weight="bold">序号</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block font-weight="bold">商品编码</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block font-weight="bold">商品名称</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block font-weight="bold">数量</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block font-weight="bold">单位</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block font-weight="bold">批次</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block font-weight="bold">生产日期</fo:block></fo:table-cell>
                    </fo:table-row>
                    <#list items as item>
                    <fo:table-row>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block>${item_index + 1}</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block>${item.goodsCode!}</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block>${item.goodsName!}</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block>${item.goodsCount!}</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block>${item.goodsUnit!}</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block>${item.goodsBatch!}</fo:block></fo:table-cell>
                        <fo:table-cell border="0.5pt solid black" padding="2pt"><fo:block>${item.goodsPrdData!}</fo:block></fo:table-cell>
                    </fo:table-row>
                    </#list>
                </fo:table-body>
            </fo:table>

            <fo:block font-size="10pt" space-before="5mm">
                打印时间：${createDate!}
            </fo:block>
        </fo:flow>
    </fo:page-sequence>
</fo:root>
