<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeroone.star.stockln.mapper.InNoticeMapper">

    <sql id="InNoticeColumns">
        i.im_notice_id                                   as imNoticeId,
        h.cus_code                                       as cusCode,
        c.zhong_wen_qch                                  as cusName,
        i.noticei_sta                                    as noticeiSta,
        i.goods_code                                     as goodsCode,
        i.goods_name                                     as goodsName,
        i.goods_count                                    as goodsCount,
        i.goods_qm_count                                 as goodsQmCount,
        i.goods_unit                                     as goodsUnit,
        i.goods_fvol                                     as goodsFvol,
        i.goods_weight                                   as goodsWeight,
        i.im_cus_code                                    as imCusCode,
        i.base_goodscount                                as baseGoodscount,
        i.base_unit                                      as baseUnit,
        date_format(i.goods_prd_data, '%Y-%m-%d %H:%i:%s') as goodsPrdData
    </sql>

    <sql id="InNoticeWhere">
        <where>
            <if test="query.imNoticeId != null and query.imNoticeId != ''">
                and i.im_notice_id like concat('%', #{query.imNoticeId}, '%')
            </if>
            <if test="query.cusCode != null and query.cusCode != ''">
                and h.cus_code like concat('%', #{query.cusCode}, '%')
            </if>
            <if test="query.createName != null and query.createName != ''">
                and c.zhong_wen_qch like concat('%', #{query.createName}, '%')
            </if>
            <if test="query.noticeiSta != null and query.noticeiSta != ''">
                and i.noticei_sta = #{query.noticeiSta}
            </if>
            <if test="query.goodsCode != null and query.goodsCode != ''">
                and i.goods_code like concat('%', #{query.goodsCode}, '%')
            </if>
            <if test="query.goodsName != null and query.goodsName != ''">
                and i.goods_name like concat('%', #{query.goodsName}, '%')
            </if>
            <if test="query.imCusCode != null and query.imCusCode != ''">
                and i.im_cus_code like concat('%', #{query.imCusCode}, '%')
            </if>
        </where>
    </sql>

    <select id="selectInNoticePage" resultType="com.zeroone.star.project.dto.j6.stockln.InNoticeVO">
        select
        <include refid="InNoticeColumns"/>
        from wm_im_notice_i i
        left join wm_im_notice_h h on i.im_notice_id = h.notice_id
        left join md_cus c on h.cus_code = c.ke_hu_bian_ma
        <include refid="InNoticeWhere"/>
        order by i.im_notice_id, i.goods_code
    </select>

    <select id="selectInNoticeList" resultType="com.zeroone.star.project.dto.j6.stockln.InNoticeVO">
        select
        <include refid="InNoticeColumns"/>
        from wm_im_notice_i i
        left join wm_im_notice_h h on i.im_notice_id = h.notice_id
        left join md_cus c on h.cus_code = c.ke_hu_bian_ma
        <include refid="InNoticeWhere"/>
        order by i.im_notice_id, i.goods_code
    </select>
</mapper>
